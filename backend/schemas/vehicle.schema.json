{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velocity.local/schemas/vehicle.schema.json",
  "title": "Normalized dealership vehicle",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "market": { "type": "string" }, "make": { "type": "string" }, "model": { "type": "string" }, "year": { "type": "integer" }, "variant": { "type": "string" },
    "condition": { "enum": ["new", "used", "reconditioned"] }, "bodyType": { "enum": ["hatchback", "sedan", "crossover", "suv", "mpv", "pickup", "coupe", "wagon"] },
    "price": { "type": "object", "properties": { "amount": { "type": "number", "minimum": 0 }, "currency": { "type": "string" }, "type": { "enum": ["fixed", "starting", "range", "contact"] }, "validAt": { "type": "string", "format": "date-time" } }, "required": ["amount", "currency", "type", "validAt"], "additionalProperties": false },
    "capacity": { "type": "object", "properties": { "seats": { "type": "integer", "minimum": 1 }, "doors": { "type": "integer", "minimum": 2 }, "bootLitres": { "type": ["number", "null"] } }, "required": ["seats", "doors", "bootLitres"], "additionalProperties": false },
    "powertrain": { "type": "object", "properties": { "fuelType": { "enum": ["petrol", "diesel", "hybrid", "phev", "electric", "cng"] }, "engineCc": { "type": ["number", "null"] }, "powerHp": { "type": ["number", "null"] }, "torqueNm": { "type": ["number", "null"] }, "transmission": { "enum": ["automatic", "manual", "cvt", "dct", "single_speed"] }, "drivetrain": { "enum": ["fwd", "rwd", "awd", "4wd"] }, "batteryKwh": { "type": ["number", "null"] }, "officialRangeKm": { "type": ["number", "null"] } }, "required": ["fuelType", "engineCc", "powerHp", "torqueNm", "transmission", "drivetrain", "batteryKwh", "officialRangeKm"], "additionalProperties": false },
    "dimensions": { "type": "object", "properties": { "lengthMm": { "type": ["number", "null"] }, "widthMm": { "type": ["number", "null"] }, "heightMm": { "type": ["number", "null"] }, "wheelbaseMm": { "type": ["number", "null"] }, "groundClearanceMm": { "type": ["number", "null"] } }, "required": ["lengthMm", "widthMm", "heightMm", "wheelbaseMm", "groundClearanceMm"], "additionalProperties": false },
    "efficiency": { "type": "object", "properties": { "officialCombinedKmPerL": { "type": ["number", "null"] }, "officialKwhPer100Km": { "type": ["number", "null"] }, "realWorldEstimate": { "type": ["number", "null"] }, "estimateUnit": { "type": ["string", "null"] } }, "required": ["officialCombinedKmPerL", "officialKwhPer100Km", "realWorldEstimate", "estimateUnit"], "additionalProperties": false },
    "features": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "safetyFeatures": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "ownership": { "type": "object", "properties": { "warrantyYears": { "type": ["number", "null"] }, "warrantyKm": { "type": ["number", "null"] }, "serviceIntervalKm": { "type": ["number", "null"] }, "partsAvailability": { "enum": ["high", "medium", "low", "unknown"] }, "resaleOutlook": { "enum": ["high", "medium", "low", "unknown"] } }, "required": ["warrantyYears", "warrantyKm", "serviceIntervalKm", "partsAvailability", "resaleOutlook"], "additionalProperties": false },
    "suitabilityTags": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "limitations": { "type": "array", "items": { "type": "string" } },
    "inventory": { "type": "object", "properties": { "status": { "enum": ["available", "limited", "reserved", "unavailable", "unknown"] }, "quantity": { "type": ["integer", "null"], "minimum": 0 }, "showroomIds": { "type": "array", "items": { "type": "string" } }, "updatedAt": { "type": ["string", "null"], "format": "date-time" } }, "required": ["status", "quantity", "showroomIds", "updatedAt"], "additionalProperties": false },
    "provenance": { "type": "object", "properties": { "verificationStatus": { "enum": ["verified", "partially_verified", "unverified", "stale"] }, "sources": { "type": "array", "items": { "type": "object", "properties": { "url": { "type": "string", "format": "uri" }, "publisher": { "type": "string" }, "sourceType": { "enum": ["manufacturer", "authorized_distributor", "dealer", "official_brochure", "government", "review"] }, "retrievedAt": { "type": "string", "format": "date-time" }, "fields": { "type": "array", "items": { "type": "string" } } }, "required": ["url", "publisher", "sourceType", "retrievedAt", "fields"], "additionalProperties": false } }, "verifiedAt": { "type": ["string", "null"], "format": "date-time" }, "verifiedBy": { "type": ["string", "null"] } }, "required": ["verificationStatus", "sources", "verifiedAt", "verifiedBy"], "additionalProperties": false }
  },
  "required": ["id", "market", "make", "model", "year", "variant", "condition", "bodyType", "price", "capacity", "powertrain", "dimensions", "efficiency", "features", "safetyFeatures", "ownership", "suitabilityTags", "limitations", "inventory", "provenance"]
}
