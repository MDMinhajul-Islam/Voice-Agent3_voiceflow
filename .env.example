# Create a local .env file and enter these values there. Never commit the API key.
RETELL_API_KEY=key_your_private_retell_api_key
RETELL_AGENT_ID=agent_your_retell_agent_id
PORT=8787
HOST=0.0.0.0
PUBLIC_ORIGIN=http://127.0.0.1:5173
CAL_API_KEY=cal_your_private_api_key
CAL_USERNAME=your_cal_username
CAL_EVENT_TYPE_SLUG=northstar-vehicle-consultation-or-test-drive
CAL_TIMEZONE=America/Chicago
RETELL_TOOL_SECRET=generate_a_long_random_secret
